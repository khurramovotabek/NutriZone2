# Copy this file to .env and fill in real values before running the project.
# For docker-compose (dev), most of these are pre-set in docker-compose.yml
# via x-backend-env; this file matters most for running manage.py directly.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Which settings module to load: config.settings.development or
# config.settings.production. manage.py/wsgi.py/asgi.py default to
# development if this isn't set.
DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave unset to fall back to a local SQLite database (fine for quick local
# work without Docker). Set this for Postgres (required in production).
DATABASE_URL=postgres://nutrizone:nutrizone@localhost:5432/nutrizone

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=14

# ---------------------------------------------------------------------------
# Throttling
# ---------------------------------------------------------------------------
THROTTLE_RATE_ANON=100/min
THROTTLE_RATE_USER=300/min
THROTTLE_RATE_OTP=5/hour

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
TIME_ZONE=UTC
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# docker-compose.prod.yml only -- required, no defaults
# ---------------------------------------------------------------------------
# POSTGRES_DB=nutrizone
# POSTGRES_USER=nutrizone
# POSTGRES_PASSWORD=
# SECURE_SSL_REDIRECT=True
